# Customer Central — portal frontend settings (supplier-portal-frontend). Copy to .env. Vite reads only VITE_* keys,
# and every value here ends up in the browser bundle: never put a secret in this file.

# The portal backend (supplier-portal-backend).
VITE_API_BASE_URL=http://127.0.0.1:5000

# Shared services, used directly by the browser only for the legacy GSTIN lookup.
VITE_SHARED_SERVICES_URL=https://fs-quad-shared.azurewebsites.net

# Identity checks: "new" (default, through the backend) or "legacy" (straight to the shared service).
VITE_VERIFICATION_MODE=new
