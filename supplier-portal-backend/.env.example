# =====================================================================================================================
# Customer Central — portal backend settings (supplier-portal-backend)
#
# The portal is LAS Central's front door: a customer registers and applies here, LAS's maker and checker decide the
# application (they call this backend at /las/*), and once the customer is active this backend reads their loans,
# documents and money from LAS (it never calls SAP itself).
#
# Copy to .env and fill in. .env is git-ignored; never commit real values. One key per line, no spaces around "=",
# no quotes. A key listed twice is a mistake: the last one silently wins.
# Keys marked [required] stop a feature (or the server) from working when empty; the rest have the default shown.
# =====================================================================================================================


# ---------------------------------------------------------------------------------------------------------------------
# 1. Server & sessions
# ---------------------------------------------------------------------------------------------------------------------
# [required in any shared or deployed setup] Signs customer sessions. Empty = a new random key on every start, so every
# customer is signed out whenever the server restarts. Generate once:  python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# Public address of the portal (the React app), used in links inside emails (agreements, verification).
PORTAL_PUBLIC_URL=http://localhost:5173
# Address of the staff (enterprise) app, used in staff email links. Leave commented to use the portal address
# (an empty value is not the same as unset here).
# ENTERPRISE_APP_URL=


# ---------------------------------------------------------------------------------------------------------------------
# 2. Database
# ---------------------------------------------------------------------------------------------------------------------
# mysql (default) or sqlite. sqlite runs on a local copy of the database (local.db, built by import_sqlite.py) — for a
# developer working offline only; it is not shared with LAS or anyone else.
DB_ENGINE=mysql
# [required for mysql]
DB_HOST=
DB_PORT=3306
DB_NAME=supplier_portal
DB_USER=
DB_PASSWORD=
# sqlite only: path of the database file. Default: supplier-portal-backend/local.db
SQLITE_PATH=


# ---------------------------------------------------------------------------------------------------------------------
# 3. LAS Central integration (both directions use a shared key; each must equal the matching key in LAS's .env)
# ---------------------------------------------------------------------------------------------------------------------
# LAS -> portal: LAS's maker/checker read and decide onboarding applications at /las/*, sending this key in X-LAS-Key.
# Same value as PORTAL_LAS_KEY in LAS's .env.  [required]
LAS_INTEGRATION_KEY=

# Portal -> LAS: the customer's loans, documents (sanction / drawdown memos, dues invoices), finance and notifications
# are read from LAS's /api/customer-portal/*, sending this key in X-Portal-Key.
# Same value as PORTAL_JOURNEY_KEY in LAS's .env.  [required once customers are active]
LAS_API_URL=http://127.0.0.1:3016
PORTAL_JOURNEY_KEY=


# ---------------------------------------------------------------------------------------------------------------------
# 4. Document storage (Azure Blob Storage) — onboarding documents and invoice PDFs
# ---------------------------------------------------------------------------------------------------------------------
# [required]
AZURE_STORAGE_CONNECTION_STRING=
AZURE_DOCS_BLOB_CONTAINER=ven-support-docs


# ---------------------------------------------------------------------------------------------------------------------
# 5. Shared services (fs-quad-shared): email templates, email/phone OTP, invoice OCR, PAN/GSTIN/Aadhaar/Demat checks
# ---------------------------------------------------------------------------------------------------------------------
SHARED_SERVICES_URL=https://fs-quad-shared.azurewebsites.net
# [required] Sent with every call to the shared services.
SHARED_SERVICE_API_KEY=
# Identity checks: the endpoint map and how long to wait for an answer.
VERIFICATION_ENDPOINTS_FILE=
VERIFICATION_TIMEOUT_SECONDS=10
# WhatsApp OTP for the phone number at sign-up.
WHATSAPP_OTP_TEMPLATE=fsverifyphone
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US


# ---------------------------------------------------------------------------------------------------------------------
# 6. Email templates (names of templates in the shared email service; empty = that email is not sent)
# ---------------------------------------------------------------------------------------------------------------------
VENDOR_CHANGE_REQUESTED_TEMPLATE=vendor_registration_submitted
VENDOR_AGREEMENT_SIGNED_TEMPLATE=
VENDOR_AGREEMENT_SIGNED_NOTICE_TEMPLATE=
VENDOR_AGREEMENT_DECLINED_TEMPLATE=
AGREEMENT_RENEWAL_REQUESTED_TEMPLATE=
# Support page through the shared service (only used when SMTP below is not set).
SUPPORT_REQUEST_TEMPLATE=


# ---------------------------------------------------------------------------------------------------------------------
# 7. Support messages (Help & Support page)
# ---------------------------------------------------------------------------------------------------------------------
# Who receives support messages while the SUPPORT email group has no members (comma separated).
SUPPORT_REQUEST_RECIPIENTS=
# The portal's own mailbox for support emails. When SMTP_HOST, SMTP_USER and SMTP_PASS are all set, these are used
# instead of the shared service. Gmail needs an app password, not the account password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Customer Central


# ---------------------------------------------------------------------------------------------------------------------
# 8. Business switches
# ---------------------------------------------------------------------------------------------------------------------
# An expired agreement puts the customer's invoice uploads on hold (true / false).
AGREEMENT_EXPIRY_HOLD=true
# Term of a new agreement, in months.
AGREEMENT_DEFAULT_TERM_MONTHS=24
# Refuse a second application with a PAN already on file (true / false).
VENDOR_PAN_DUPLICATE_CHECK=false


# ---------------------------------------------------------------------------------------------------------------------
# Not read by this backend — do not add here
# ---------------------------------------------------------------------------------------------------------------------
# SAP_USERNAME, SAP_PASSWORD, SAP_TIMEOUT_SECONDS, SAP_VERIFY_SSL: the portal never connects to SAP; LAS Central does,
# with its own credentials in LAS's .env (config/sap-services.json). Keeping SAP credentials here only widens who
# can see them.
